# Copy to pipeline/.env for local runs. Real values live in Google Secret Manager for cloud jobs.
# Never commit a real .env.

# Postgres connection string for the pipeline_* tables (the existing Supabase Postgres).
# Supabase dashboard > Project Settings > Database > Connection string.
PIPELINE_DATABASE_URL=

# Blob storage: "local" (default, for development and tests) or "gcs".
PIPELINE_BLOB_BACKEND=local
# Directory used when PIPELINE_BLOB_BACKEND=local
PIPELINE_BLOB_ROOT=./.blobs
# Bucket used when PIPELINE_BLOB_BACKEND=gcs
PIPELINE_GCS_BUCKET=

# Set to 1 to refuse to start on invalid config (used on Cloud Run).
STRICT_CONFIG=0
